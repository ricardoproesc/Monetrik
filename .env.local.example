# ============================================================
#  MONETRIK — Variáveis de Ambiente (.env.local)
#  Copie este arquivo para .env.local e preencha os valores.
#  NUNCA versione o .env.local no git.
# ============================================================

# -----------------------------------------------------------
# GEMINI AI  (servidor — sem prefixo VITE_)
# Obtenha em: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------
GEMINI_API_KEY=sua_chave_gemini_aqui

# -----------------------------------------------------------
# FIREBASE — Configuração do Cliente (expostos ao browser)
# Obtenha em: Firebase Console → Configurações do projeto
# -----------------------------------------------------------
VITE_FIREBASE_API_KEY=sua_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# -----------------------------------------------------------
# BANCO DE DADOS — Postgres (servidor / Prisma)
# Local: postgresql://usuario:senha@localhost:5432/postgres
# Produção: use um Postgres gerenciado (Neon, Supabase, etc.) —
# a Vercel NÃO acessa um localhost.
# -----------------------------------------------------------
DATABASE_URL=postgresql://postgres:senha@localhost:5432/postgres

# Projeto Firebase usado pelo BACKEND para validar o ID token (verifyIdToken).
# Normalmente igual ao VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=seu-projeto-id

# -----------------------------------------------------------
# URL DA APLICAÇÃO (opcional — para callbacks OAuth)
# -----------------------------------------------------------
APP_URL=https://monetrik.vercel.app
