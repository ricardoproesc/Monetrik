# ============================================================
#  MONETRIK — Variáveis de Ambiente (.env.local)
#  Copie este arquivo para .env.local e preencha os valores.
#  NUNCA versione o .env.local no git.
# ============================================================

# -----------------------------------------------------------
# GEMINI AI  (servidor — sem prefixo VITE_)
# Obtenha em: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------
GEMINI_API_KEY=sua_chave_gemini_aqui

# -----------------------------------------------------------
# FIREBASE — Configuração do Cliente (expostos ao browser)
# Obtenha em: Firebase Console → Configurações do projeto
# -----------------------------------------------------------
VITE_FIREBASE_API_KEY=sua_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# -----------------------------------------------------------
# BANCO DE DADOS — Postgres (servidor / Prisma)
# Local: postgresql://usuario:senha@localhost:5432/postgres
# Produção: use um Postgres gerenciado (Neon, Supabase, etc.) —
# a Vercel NÃO acessa um localhost.
# -----------------------------------------------------------
DATABASE_URL=postgresql://postgres:senha@localhost:5432/postgres

# Projeto Firebase usado pelo BACKEND para validar o ID token (verifyIdToken).
# Normalmente igual ao VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=seu-projeto-id

# Service account do Firebase — necessária para o backend GERAR o link de
# verificação de e-mail (operação privilegiada). Firebase Console →
# Configurações do projeto → Contas de serviço → Gerar nova chave privada.
# Cole o JSON em UMA linha (minificado).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...gserviceaccount.com"}

# -----------------------------------------------------------
# E-MAIL TRANSACIONAL — Resend (e-mail de verificação bonito + sem Spam)
# 1) Crie a conta e a API key em https://resend.com
# 2) Verifique seu DOMÍNIO no Resend (configure SPF/DKIM/DMARC no DNS) — é isso
#    que garante a caixa de entrada em vez do Spam.
# 3) Use um remetente do seu domínio verificado em EMAIL_FROM.
# -----------------------------------------------------------
RESEND_API_KEY=re_sua_chave_resend
EMAIL_FROM=Monetrik <nao-responda@seudominio.com>

# (Opcional) URL pública (PNG/JPG) da logo do Monetrik para o cabeçalho do
# e-mail. Sem isso, o e-mail mostra um selo "M" com a cor da marca.
# Ex.: https://monetrik.com.br/logo.png  (ou /logo.png servido pelo próprio app)
LOGO_URL=

# TELA DE VERIFICAÇÃO PERSONALIZADA:
# Para usar a nossa tela (bonita, em pt-br) em vez da padrão do Firebase,
# no Firebase Console → Authentication → Templates → (editar) →
# "Personalizar URL de ação" → https://SEU_APP/auth/action

# -----------------------------------------------------------
# URL DA APLICAÇÃO (usada nos links do e-mail e callbacks)
# -----------------------------------------------------------
APP_URL=https://monetrik.vercel.app
